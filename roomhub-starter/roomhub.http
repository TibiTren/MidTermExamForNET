### 6. Get room -> 200 { id, name, capacity }
GET {{baseUrl}}/api/rooms/{{smallRoomId}}

> {%
    client.test("Get room -> 200 with body", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.id === client.global.get("smallRoomId"), "Wrong id");
        client.assert(response.body.name === "Small", "Wrong name");
        client.assert(response.body.capacity === 10, "Wrong capacity");
    });
%}

