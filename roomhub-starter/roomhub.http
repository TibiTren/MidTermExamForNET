# ======================================================================
# R11: cancel only if the booking starts at least 60 minutes from now
# ======================================================================

### 55. R11: booking that starts in 30 minutes -> 201
POST {{baseUrl}}/api/rooms/{{roomA}}/bookings
Content-Type: application/json

{ "bookedBy": "{{run}}-soon", "startUtc": "{{soonStart}}", "endUtc": "{{soonEnd}}", "attendees": 2 }

> {%
    client.test("R11 create booking starting in 30 min -> 201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.global.set("soonId", response.body.id);
%}

### 56. R11: cancel it (less than 60 minutes before start) -> 409
POST {{baseUrl}}/api/bookings/{{soonId}}/cancel

> {%
    client.test("R11 cancel < 60 min before start -> 409", function () {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
    });
%}

### 57. R11: the rejected cancel leaves the booking Active
GET {{baseUrl}}/api/bookings/{{soonId}}

> {%
    client.test("R11 booking is still Active", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.status === "Active", "Expected Active, got " + response.body.status);
    });
%}

