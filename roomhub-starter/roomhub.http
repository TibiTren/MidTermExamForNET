# ======================================================================
# BOOKINGS: create / get / overlap (R7)
# ======================================================================

### 32. Create booking in room C, 10:00-12:00 -> 201 + Location + { id, roomId, status }
POST {{baseUrl}}/api/rooms/{{roomC}}/bookings
Content-Type: application/json

{ "bookedBy": "{{run}}-ana", "startUtc": "2030-09-01T10:00:00Z", "endUtc": "2030-09-01T12:00:00Z", "attendees": 4 }

> {%
    client.test("Create booking -> 201 with Location and body", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.headers.valueOf("Location") === "/api/bookings/" + response.body.id, "Wrong Location header");
        client.assert(response.body.roomId === client.global.get("roomC"), "Wrong roomId");
        client.assert(response.body.status === "Active", "Expected status Active");
    });
    client.global.set("bookingId", response.body.id);
%}

### 33. Get booking -> 200 with all fields, dates in UTC
GET {{baseUrl}}/api/bookings/{{bookingId}}

> {%
    client.test("Get booking -> 200 with all fields", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.id === client.global.get("bookingId"), "Wrong id");
        client.assert(response.body.roomId === client.global.get("roomC"), "Wrong roomId");
        client.assert(response.body.bookedBy === client.global.get("run") + "-ana", "Wrong bookedBy");
        client.assert(response.body.startUtc === "2030-09-01T10:00:00Z", "Wrong startUtc: " + response.body.startUtc);
        client.assert(response.body.endUtc === "2030-09-01T12:00:00Z", "Wrong endUtc: " + response.body.endUtc);
        client.assert(response.body.attendees === 4, "Wrong attendees");
        client.assert(response.body.status === "Active", "Expected status Active");
    });
%}

