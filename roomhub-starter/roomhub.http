# RoomHub API checks for the contract and rules R1-R11.
#
# How to run (Rider / JetBrains HTTP Client):
#   1. Start the API (it listens on http://localhost:5090).
#   2. In this file, click "Run All Requests in File" (the double green arrow at the top).
#   3. Open the "Tests" tab in the Services window to see which checks passed or failed.
#
# Requests depend on the ones above them (room ids, booking ids, times), so run them in order.
# Every run uses new rooms and a random suffix for the people names. The data in SQLite
# from earlier runs therefore does not affect the results, and the file can be run many times.

@baseUrl = http://localhost:5090

### 0. Setup: API is up, create a run id and times relative to "now"
GET {{baseUrl}}/

> {%
    client.test("API is running", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    const now = Date.now();
    const iso = function (minutes) {
        return new Date(now + minutes * 60000).toISOString().replace(/\.\d{3}Z$/, "Z");
    };
    client.global.set("run", Math.random().toString(36).substring(2, 8));
    client.global.set("pastStart", iso(-1));
    client.global.set("pastEnd", iso(30));
    client.global.set("r5Start", iso(5));
    client.global.set("r5End", iso(20));
    client.global.set("soonStart", iso(30));
    client.global.set("soonEnd", iso(60));
    client.global.set("laterStart", iso(65));
    client.global.set("laterEnd", iso(120));
%}

# ======================================================================
# ROOMS
# ======================================================================

### 1. Create room "Small" (capacity 10) -> 201 + Location + { id, name, capacity }
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{ "name": "Small", "capacity": 10 }

> {%
    client.test("Create room -> 201 with Location and body", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.headers.valueOf("Location") === "/api/rooms/" + response.body.id, "Wrong Location header");
        client.assert(response.body.name === "Small", "Wrong name");
        client.assert(response.body.capacity === 10, "Wrong capacity");
    });
    client.global.set("smallRoomId", response.body.id);
%}

### 2. Create room "Big" (capacity 11, so R10 applies)
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{ "name": "Big", "capacity": 11 }

> {%
    client.test("Create big room -> 201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.global.set("bigRoomId", response.body.id);
%}

